# Copy this file to .env and fill in the secret value.
# .env is ignored by git. Never commit it.

# Chalk Model Gateway key (get it privately from the team lead)
CHALK_ROUTER_API_KEY=

# Not secret
CHALK_ENV_ID=clkdcdaf84e
CHALK_BASE_URL=https://api.chalk.ai/v1/router

# Sponsor-issued router keys are restricted to this model.
LLM_MODEL=openai/gpt-6-sol

# Optional API access token (leave blank for local development).
# When set, send X-WT-Token on /api requests other than /api/health.
WT_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
WT_MAX_BODY_BYTES=1000000
WT_MAX_CONCURRENT=4
WT_RATE_LIMIT_PER_MIN=60

# LLM fallback limits; analyses can return partial parsing with warnings.
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
LLM_TOTAL_BUDGET_S=60
LLM_MAX_CRITERIA=40
LLM_MAX_WORKERS=6
