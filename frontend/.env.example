# Enable backend-backed synthetic simulation instead of the local mock service.
VITE_USE_BACKEND=false
VITE_API_BASE_URL=http://localhost:8000
# local uses the checked-in cohort; chalk uses a Chalk query and falls back locally if unavailable.
VITE_SCENARIO_SOURCE=local

# Only needed when the backend is started with WT_API_TOKEN.
# Never commit a real token.
VITE_API_TOKEN=
