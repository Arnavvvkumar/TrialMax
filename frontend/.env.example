# Blank uses the same origin. Vite proxies /api to localhost:8000 during development.
# Set an absolute API origin only when deploying the frontend separately.
VITE_API_BASE_URL=

# Only needed when the backend is started with WT_API_TOKEN.
# This is browser-visible configuration, not secure secret storage.
# Never put a Chalk/provider API key here or in any VITE_ variable.
# Do not commit real access tokens.
VITE_API_TOKEN=
